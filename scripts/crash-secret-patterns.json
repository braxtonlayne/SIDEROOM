{
  "_comment": "OPS-CRASH-001 (wave 45-A). Secret shapes that must never appear in a crash card, on top of the repo-wide list in scripts/secret-scan.mjs (private keys, AWS key ids, GitHub and Discord tokens, passwords in URLs). Each entry: name, a JavaScript regex source and its flags. Used by scripts/check-crash-card.mjs, the web unit test of the client allow-list and the Playwright gate. A hit is reported by name only, never by value.",
  "patterns": [
    { "name": "bearer-token", "re": "\\bBearer\\s+[A-Za-z0-9._~+/=-]{8,}", "flags": "i" },
    { "name": "jwt", "re": "\\beyJ[A-Za-z0-9_-]{8,}\\.[A-Za-z0-9_-]{4,}", "flags": "" },
    {
      "name": "presigned-url-query",
      "re": "X-Amz-(?:Signature|Credential|Security-Token|Algorithm)|[?&](?:Signature|Expires|AWSAccessKeyId)=",
      "flags": "i"
    },
    { "name": "sr-guest-token", "re": "\\bsrg_[0-9a-f]{16,}", "flags": "i" },
    {
      "name": "session-cookie",
      "re": "\\bsr_session\\b|\\bsession(?:id)?=[A-Za-z0-9]{8,}",
      "flags": "i"
    },
    {
      "name": "ipv4-address",
      "re": "(?:^|[^A-Za-z0-9.])(?:\\d{1,3}\\.){3}\\d{1,3}(?![0-9])",
      "flags": ""
    },
    {
      "name": "ipv6-address",
      "re": "\\b(?:[0-9a-f]{1,4}:){7}[0-9a-f]{1,4}\\b|\\b[0-9a-f]{1,4}:(?:[0-9a-f]{0,4}:){1,6}[0-9a-f]{1,4}\\b",
      "flags": "i"
    },
    {
      "name": "email-address",
      "re": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}",
      "flags": ""
    },
    { "name": "url", "re": "\\b[a-z][a-z0-9+.-]{1,20}://", "flags": "i" },
    {
      "name": "object-storage-host",
      "re": "amazonaws\\.com|r2\\.cloudflarestorage\\.com|\\bs3[.-][a-z0-9.-]+",
      "flags": "i"
    },
    { "name": "long-hex-secret", "re": "\\b[0-9a-f]{41,}\\b", "flags": "i" },
    {
      "name": "e2ee-key-material",
      "re": "E2EEKEY|\\bmls[_-]?(?:secret|key|welcome)\\b",
      "flags": "i"
    }
  ]
}
