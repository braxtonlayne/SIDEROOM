{
  "name": "@sideroom/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Typed REST client generated from the Rust OpenAPI document (FND-API-005).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./mocks": "./src/mocks/index.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mocks:generate": "node scripts/gen-msw.mjs",
    "mocks:check": "node scripts/gen-msw.mjs --check"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "msw": "^3.0.3",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "vitest": "^2.1.8"
  }
}
