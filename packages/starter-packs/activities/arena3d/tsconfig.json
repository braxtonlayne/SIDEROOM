{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "sim/**/*.js",
    "net/**/*.js",
    "render/**/*.js",
    "assets/**/*.js",
    "client/**/*.js",
    "platform/**/*.js",
    "replay/**/*.js",
    "types/**/*.d.ts"
  ]
}
