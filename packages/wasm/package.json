{
  "name": "@sideroom/wasm",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Rust compiled to WebAssembly (sr-theme, sr-markdown, sr-permissions, graph layout, library pre-checks, sr-e2ee) with a typed ESM facade. Built by wasm-pack from crates/*-wasm.",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./theme.schema.json": "./theme.schema.json"
  },
  "files": [
    "src",
    "dist",
    "theme.schema.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
