    /// Called for every guild event while the module is enabled in that guild. Act only
    /// through `ctx.actions`; keep what you learn in `ctx.state`.
    fn on_event<'a>(
        &'a self,
        ev: &'a DomainEvent,
        ctx: &'a FeatureCtx,
    ) -> BoxFuture<'a, Result<(), FeatureError>> {
        Box::pin(async move {
            let DomainEvent::MessageSent {
                guild: Some(guild),
                author,
                ..
            } = ev
            else {
                return Ok(());
            };
            // Never react to our own posts.
            if *author == ctx.actions.self_user() {
                return Ok(());
            }
            let cfg: Config = ctx.guild_config(__CONST__, *guild).await?;
            let Some(channel) = cfg.channel.as_deref().and_then(snowflake) else {
                return Ok(());
            };
            ctx.actions
                .post_message(
                    sr_events::ChannelId::new(channel),
                    OutMessage::text("TODO"),
                )
                .await?;
            Ok(())
        })
    }
}

#[cfg(test)]
mod tests {
    use sr_events::{ChannelId, GuildId, UserId};

    use super::*;
    use crate::FeatureRegistry;
    use crate::testing::Harness;

    #[test]
    fn schema_defaults_validate() {
        let s = __TYPE__.settings_schema();
        s.validate(&s.defaults(Scope::Guild)).unwrap();
    }

    #[tokio::test]
    async fn does_nothing_until_configured() {
        let mut reg = FeatureRegistry::new();
        reg.register(__TYPE__).unwrap();
        let h = Harness::new(reg).await;
        let ev = DomainEvent::MessageSent {
            guild: Some(GuildId::new(1)),
            channel: ChannelId::new(10),
            message_id: 1,
            author: UserId::new(5),
            data: json!({}),
        };
        __TYPE__.on_event(&ev, &h.ctx).await.unwrap();
        assert!(h.actions.calls().is_empty());
    }
}
