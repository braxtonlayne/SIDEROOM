{
  "description": "Cut cases for the preview excerpt (D-728), run by crates/sr-chat/src/preview.rs and by apps/web/src/lounge/__tests__/p70Plain.test.tsx with the same inputs and outputs. A part is a string or {repeat, times}; parts are joined. want null: no text. max is 140 unless given.",
  "cases": [
    { "name": "plain 140 letters is whole", "input": [{ "repeat": "a", "times": 140 }], "want": [{ "repeat": "a", "times": 140 }] },
    { "name": "plain 141 letters is cut", "input": [{ "repeat": "a", "times": 141 }], "want": [{ "repeat": "a", "times": 140 }, "\u2026"] },
    { "name": "a spoiler split at the cut", "input": ["a ||", { "repeat": "x", "times": 200 }, "||"], "want": ["a ||", { "repeat": "x", "times": 136 }, "||\u2026"] },
    { "name": "a spoiler that ends before the cut is kept", "input": ["a ||hid|| ", { "repeat": "x", "times": 200 }], "want": ["a ||hid|| ", { "repeat": "x", "times": 130 }, "\u2026"] },
    { "name": "a spoiler wholly after the cut", "input": [{ "repeat": "x", "times": 150 }, " ||secret||"], "want": [{ "repeat": "x", "times": 140 }, "\u2026"] },
    { "name": "a mention split at the cut", "input": [{ "repeat": "x", "times": 130 }, " <@123456789012345678> tail"], "want": [{ "repeat": "x", "times": 130 }, "\u2026"] },
    { "name": "a custom emoji split at the cut", "input": [{ "repeat": "x", "times": 130 }, " <:wave:123456789012345678> tail"], "want": [{ "repeat": "x", "times": 130 }, "\u2026"] },
    { "name": "a link split at the cut", "input": [{ "repeat": "x", "times": 130 }, " [label](https://example.com/page) tail"], "want": [{ "repeat": "x", "times": 130 }, "\u2026"] },
    { "name": "bold split at the cut", "input": [{ "repeat": "x", "times": 130 }, " **bold words here** tail"], "want": [{ "repeat": "x", "times": 130 }, " **bold wo**\u2026"] },
    { "name": "a code span split at the cut", "input": [{ "repeat": "x", "times": 130 }, " `some code here` tail"], "want": [{ "repeat": "x", "times": 130 }, " `some cod`\u2026"] },
    { "name": "bold that ends before the cut is kept", "input": ["**b** ", { "repeat": "x", "times": 200 }], "want": ["**b** ", { "repeat": "x", "times": 134 }, "\u2026"] },
    { "name": "one long spoiler reads as a closed spoiler", "input": ["||", { "repeat": "x", "times": 300 }, "||"], "want": ["||", { "repeat": "x", "times": 138 }, "||\u2026"] },
    { "name": "a short spoiler is not touched", "input": ["look ||", { "repeat": "x", "times": 20 }, "||"], "want": ["look ||", { "repeat": "x", "times": 20 }, "||"] },
    { "name": "one long bold sentence", "input": ["**", { "repeat": "word ", "times": 59 }, "word**"], "want": ["**", { "repeat": "word ", "times": 27 }, "wor**\u2026"] },
    { "name": "one long italic sentence", "input": ["*", { "repeat": "word ", "times": 59 }, "word*"], "want": ["*", { "repeat": "word ", "times": 27 }, "word*\u2026"] },
    { "name": "one long underlined sentence", "input": ["__", { "repeat": "word ", "times": 59 }, "word__"], "want": ["__", { "repeat": "word ", "times": 27 }, "wor__\u2026"] },
    { "name": "one long struck sentence", "input": ["~~", { "repeat": "word ", "times": 59 }, "word~~"], "want": ["~~", { "repeat": "word ", "times": 27 }, "wor~~\u2026"] },
    { "name": "one long code span", "input": ["`", { "repeat": "word ", "times": 59 }, "word`"], "want": ["`", { "repeat": "word ", "times": 27 }, "word`\u2026"] },
    { "name": "a spoiler inside bold is not closed by one mark", "input": ["**a ||", { "repeat": "x", "times": 200 }, "|| b**"], "want": null }
  ]
}
