# Production environment for deploy/compose/prod.yml. Copy to .env.prod, replace every CHANGE_ME, and keep the
# result out of version control and out of backups that leave the server unencrypted.
# Generate secrets fresh:   openssl rand -hex 32   (secret key)   openssl rand -base64 24   (passwords)

SR_DOMAIN=chat.example.org
SR_IMAGE=ghcr.io/example-owner/sideroom-server:0.0.0
# Directory containing the built web app (the contents of apps/web/dist from the release).
SR_WEB_DIR=/opt/sideroom/web

POSTGRES_PASSWORD=CHANGE_ME
# 64 hex characters. Losing it loses every stored TOTP secret; back it up with the dumps (BACKUP.md).
SR_SECRET_KEY=CHANGE_ME

GARAGE_BUCKET=sideroom
GARAGE_ACCESS_KEY=CHANGE_ME
GARAGE_SECRET_KEY=CHANGE_ME

SMTP_HOST=mail.example.org
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_FROM=SIDE ROOM <no-reply@example.org>
SMTP_USERNAME=
SMTP_PASSWORD=

# Local ingest folder (REV-UP-005): mounted read-only into sr-server at /srv/sideroom/ingest. SR_INGEST_ROOTS is the
# path inside the container (empty turns local folders off); SR_INGEST_DIR is the folder on this host.
SR_INGEST_DIR=/srv/sideroom/ingest
SR_INGEST_ROOTS=/srv/sideroom/ingest

# Only used with --profile monitoring.
GRAFANA_PASSWORD=CHANGE_ME

# Donations (D-288). Leave the Esplora URL empty to keep donations off. Either turn the `payments` Compose profile on and
# set it to http://electrs:3000 (with SR_PAYMENTS_ALLOW_PRIVATE_HOSTS=1), or use the interim https://mempool.space/api
# (mempool.space then learns which addresses this server watches). See docs/12 and docs/specs/donations.md.
SR_PAYMENTS_ESPLORA_URL=
SR_PAYMENTS_ALLOW_PRIVATE_HOSTS=
# Price sources: the median of three keyless public APIs, any that disagree by more than 10% are refused.
SR_PAYMENTS_RATE_SOURCES='[{"name":"coinbase","url":"https://api.coinbase.com/v2/prices/BTC-USD/spot","pointer":"/data/amount"},{"name":"kraken","url":"https://api.kraken.com/0/public/Ticker?pair=XBTUSD","pointer":"/result/XXBTZUSD/c/0"},{"name":"coingecko","url":"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd","pointer":"/bitcoin/usd"}]'
# Only used with --profile payments.
SR_ELECTRS_DAEMON_RPC_ADDR=host.docker.internal:8332
SR_BITCOIND_DIR=/var/lib/bitcoind
