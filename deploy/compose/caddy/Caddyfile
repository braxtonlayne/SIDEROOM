# Dev reverse proxy: http://localhost:8088 -> web (Vite) + sr-server on the host.
{
	auto_https off
	admin off
}

:80 {
	encode zstd gzip

	handle /api/* {
		reverse_proxy host.docker.internal:8080
	}
	handle /gateway* {
		reverse_proxy host.docker.internal:8080
	}
	# The embedded SFU's signalling WebSocket (media uses UDP/TCP ports of its own).
	handle /voice/* {
		reverse_proxy host.docker.internal:8080
	}
	handle /cdn/* {
		reverse_proxy host.docker.internal:8080
	}
	# CSP violation reports (RDY-SEC-009): the only /internal path that is public.
	@cspReport {
		method POST
		path /internal/csp-report
	}
	handle @cspReport {
		reverse_proxy host.docker.internal:8080
	}
	handle /internal/* {
		respond 404
	}
	handle {
		reverse_proxy host.docker.internal:5173
	}
}
