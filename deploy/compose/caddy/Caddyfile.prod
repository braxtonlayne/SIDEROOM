# Production reverse proxy (XC-OPS-001, XC-SEC-001). TLS via ACME is automatic.
#
#   SR_DOMAIN      public hostname, e.g. chat.example.org
#   SR_WEB_ROOT    directory holding the built web app (apps/web/dist), default /srv/web
#   SR_UPSTREAM    sr-server public listener, default 127.0.0.1:8080
#
# Caddy serves only the public files (D-385, docs/dev/entrance-isolation.md): the landing, sign-in and invite pages,
# their assets, the fonts, icons and the service worker. The app itself (`/app`, `/app/*`, every in-app path) is
# proxied to sr-server, which serves it from SR_WEB__ROOT (the same dist, mounted read-only into the server) to a
# request with a session only. The public policy in the generated block is built by apps/web/src/security/csp.ts;
# csp.test.ts fails if the two drift apart. After a change to the public surface list or the settings run
# `node deploy/scripts/render-caddyfile.mjs --public-url <url> [--activities] [--voice-url <url>]`, and build the
# web app with the same values (`VITE_PUBLIC_URL`, `VITE_ACTIVITIES_ENABLED=true`, `VITE_VOICE_PUBLIC_URL`).
# The app policy is not here: the app build writes it to app/csp.txt and sr-server sends it. Activities also need the
# wildcard host in deploy/compose/caddy/activities.snippet (DNS-challenge certificate; docs/12 section 1). They
# are off by default: the feature is not built yet and the certificate needs a DNS provider.
{
	servers {
		protocols h1 h2 h3
	}
}

{$SR_DOMAIN} {
	encode zstd gzip

	# Applied to every response; sr-server adds its own stricter API headers on /api, /cdn and /gateway.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "accelerometer=(), geolocation=(), gyroscope=(), magnetometer=(), payment=(), usb=(), interest-cohort=(), camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), clipboard-write=(self)"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	# Only the landing page is indexable (D-384, OPS-IDX-001): every response except the document at `/` says
	# noindex, so a crawler that never runs JavaScript still reads the rule (robots.txt and the SPA's robots meta
	# are the other two layers). Set per matcher, not removed later, so it does not depend on directive order. The `>`
	# defers the set until the upstream answered, so it replaces the copy sr-server also sends instead of adding a
	# second value ("noindex, nofollow, noindex, nofollow" on /api and /cdn, prod-smoke on PR #57).
	@notLanding not path /
	header @notLanding >X-Robots-Tag "noindex, nofollow"

	# The one internal path browsers must reach: Content-Security-Policy violation reports (RDY-SEC-009). The server
	# rate limits it, caps the body and keeps counters only.
	@cspReport {
		method POST
		path /internal/csp-report
	}
	handle @cspReport {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}

	# Internal endpoints are never public.
	handle /internal/* {
		respond 404
	}

	handle /api/* {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}
	handle /gateway* {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}
	handle /cdn/* {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}
	handle /healthz {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}
	handle /developers/* {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}

	# A Web Share Target POST that no service worker intercepted: send the browser to the
	# share page with a GET (303), which asks the person to open SIDE ROOM once and share again.
	@sharePost {
		method POST
		path /share
	}
	handle @sharePost {
		redir /share 303
	}

	# ---- D-385 entrance isolation (docs/dev/entrance-isolation.md section 3) -----------------------------------
	# A visitor without a session is given the public files below and nothing else. Every other path, /app and
	# /app/* included, goes to sr-server, which checks the session before it looks at the path (302 to /login for
	# a page, an empty 401 for a file; the same whether the path exists or not). There is no try_files: a path
	# that is not listed here is never answered from the web root.
	#
	# The block between the markers is generated by `node deploy/scripts/render-caddyfile.mjs` from
	# apps/web/public-surfaces.json (and the public policy from apps/web/src/security/csp.ts); do not edit it by
	# hand. The app's own policy is not in this file: sr-server sends it from app/csp.txt.

	# Dotted names (the build's .vite folder) are never public.
	@dotfiles path_regexp dot (^|/)\.[^/]
	handle @dotfiles {
		respond 404
	}

	# surfaces:begin
	@landing path / /join/*
	handle @landing {
		root * {$SR_WEB_ROOT:/srv/web}
		rewrite * /index.html
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /internal/csp-report; report-to csp-endpoint"
		header Reporting-Endpoints "csp-endpoint=\"/internal/csp-report\""
		header Cache-Control "no-cache"
		file_server
	}

	@auth path /login /login/* /register /forgot /reset/* /verify-email/* /email-change/cancel /oauth/discord/callback
	handle @auth {
		root * {$SR_WEB_ROOT:/srv/web}
		rewrite * /auth.html
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /internal/csp-report; report-to csp-endpoint"
		header Reporting-Endpoints "csp-endpoint=\"/internal/csp-report\""
		header Cache-Control "no-cache"
		file_server
	}

	@invite path /invite/* /template/* /no-invitation
	handle @invite {
		root * {$SR_WEB_ROOT:/srv/web}
		rewrite * /invite.html
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /internal/csp-report; report-to csp-endpoint"
		header Reporting-Endpoints "csp-endpoint=\"/internal/csp-report\""
		header Cache-Control "no-cache"
		file_server
	}

	@profile path /~*
	handle @profile {
		root * {$SR_WEB_ROOT:/srv/web}
		rewrite * /profile.html
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; report-uri /internal/csp-report; report-to csp-endpoint"
		header Reporting-Endpoints "csp-endpoint=\"/internal/csp-report\""
		header Cache-Control "no-cache"
		file_server
	}

	# The legal page is plain HTML rendered by sr-server (the operator's country and contact are filled in there).
	@legal path /house-notes
	handle @legal {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}

	@publicFiles path /entrance/* /fonts/* /icons/* /sw.js /manifest.webmanifest /offline.html /offline.css /robots.txt /THIRD_PARTY_NOTICES.md
	handle @publicFiles {
		root * {$SR_WEB_ROOT:/srv/web}
		@immutable path /entrance/* /fonts/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		@revalidate path /sw.js /manifest.webmanifest /offline.html /offline.css
		header @revalidate Cache-Control "no-cache"
		file_server
	}
	# surfaces:end

	# Everything else: /app, /app/*, every in-app path, the Scalar viewer already above. sr-server gates it.
	handle {
		reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
	}

	# Caddy's own errors (sr-server restarting is a 502) show plain pages with no script, never an empty body or
	# the upstream's text. An upstream's own 404 is passed through as it is.
	handle_errors {
		root * {$SR_WEB_ROOT:/srv/web}
		@notFound expression {err.status_code} == 404
		rewrite @notFound /404.html
		@upstreamDown expression {err.status_code} >= 500
		rewrite @upstreamDown /50x.html
		header Content-Security-Policy "default-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		header Cache-Control "no-store"
		file_server
	}
}
