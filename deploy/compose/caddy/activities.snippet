# Opt-in: the Activities wildcard host (XC-OPS-001, DEV-ACT). NOT part of the default Caddyfile.prod.
#
# Activities run in sandboxed iframes served from a separate origin per application, so a third-party
# activity can never touch the app's cookies or storage: https://<application-id>.activities.<domain>.
# That needs a wildcard certificate, which ACME only issues through a DNS challenge, so this block needs a
# Caddy build that includes your DNS provider's module (for example `caddy add-package
# github.com/caddy-dns/cloudflare`, or `xcaddy build --with github.com/caddy-dns/cloudflare`) and an API
# token in the environment. A default install has neither, which is why it ships as a snippet.
#
# To enable it:
#   1. Add DNS: *.activities.<domain> pointing at this host.
#   2. Append this block to Caddyfile.prod (outside the {$SR_DOMAIN} block), replace the DNS provider line.
#   3. Append `https://*.activities.<domain>` to frame-src in the app shell's Content-Security-Policy, in
#      Caddyfile.prod and in the web build's SR_CSP_FRAME (apps/web/src/security/csp.ts keeps the two in
#      step; docs/12 section 1).
#   4. Turn it on in the server: `[activities] enabled = true` (env SR_ACTIVITIES__ENABLED=true), and build the
#      web app with VITE_ACTIVITIES_ENABLED=true.
#
# sr-server answers this host itself (`routes::activities::proxy`): it serves only an approved application's
# reviewed entry document and the paths its URL mappings allow, from the SSRF-safe client, and sets the
# Content-Security-Policy (`frame-ancestors` is the app shell only), nosniff and Permissions-Policy on every
# response. The Host header must reach the server unchanged, which Caddy's reverse_proxy does by default. The
# activity origin gets no app credentials.
*.activities.{$SR_DOMAIN} {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
		# D-384: only the landing page is indexable, and an activity host never is.
		X-Robots-Tag "noindex, nofollow"
	}

	# Defence in depth: the server also sets this, but a response it did not produce still may be framed by
	# the app shell and nothing else.
	header Content-Security-Policy "frame-ancestors https://{$SR_DOMAIN}"

	reverse_proxy {$SR_UPSTREAM:127.0.0.1:8080}
}
