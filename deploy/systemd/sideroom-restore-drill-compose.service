# Route: Compose route (it execs into the postgres container). The plain-binary route uses sideroom-restore-drill.service.
[Unit]
Description=SIDE ROOM restore drill on the Compose stack (restore the newest backup into a throwaway database)
After=docker.service sideroom-backup-compose.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/sideroom
# The command of deploy/scripts/prod-smoke.sh (stage_backups, step 4). Runs as the postgres user inside the postgres
# container; the role sideroom may CREATE DATABASE. A good drill touches restore-drill.ok in the pg-backups volume.
ExecStart=/usr/bin/docker compose -f /opt/sideroom/deploy/compose/prod.yml --env-file /opt/sideroom/deploy/compose/.env.prod exec -T -u postgres postgres sh -c "SR_DATABASE_URL=postgres://sideroom@/sideroom SR_BACKUP_DIR=/var/backups/sideroom sh /opt/sideroom/scripts/restore-drill.sh"
Nice=10
IOSchedulingClass=idle
